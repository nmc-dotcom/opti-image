# Build-time feature flags (copy to .env.local to override; see src/lib/features.ts)

# AI inpainting (MI-GAN, downloads a ~28MB model on first use). Default: off.
# Enable only after confirming the model/training-data licence fits your deployment.
VITE_ENABLE_AI_INPAINTING=false

# PatchMatch exemplar fill for thick selections. Default: off (commercial-safe).
# By default thick selections use the frequency-separation texture fill instead and the PatchMatch
# code is not part of the bundle. Enable only after its patent/licence status is cleared for you.
VITE_ENABLE_PATCHMATCH=false
